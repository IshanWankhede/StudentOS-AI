# StudentOS AI - environment template.
# Placeholders only. Never commit real secrets. Copy to .env for local use.
# Documented in docs/21-deployment.md#environment-variables

# ---------- Application ----------
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                     # must be true in staging/production

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://studentos:change-me@localhost:5432/studentos
DB_POOL_SIZE=10

# ---------- Authentication (docs/07-authentication.md) ----------
JWT_SECRET=replace-with-at-least-64-random-bytes-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30            # absolute lifetime of a refresh-token family

# ---------- Google (docs/13-google-integrations.md) ----------
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes   # encrypts Google tokens at rest
TOKEN_ENCRYPTION_KEY_ID=v1              # supports key rotation

# ---------- AI (docs/09-ai-architecture.md) ----------
LLM_PROVIDER=fake                       # fake | anthropic | openai | gemini (fake needs no key)
LLM_API_KEY=replace-me
LLM_MODEL_FAST=replace-me               # logical tier "fast"
LLM_MODEL_STANDARD=replace-me           # logical tier "standard"
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=replace-me
EMBEDDING_DIMENSIONS=1024               # must match the vector(1024) column
AI_DAILY_REQUEST_LIMIT_PER_USER=30
AI_GLOBAL_MONTHLY_BUDGET_USD=100        # circuit breaker, see docs/09-ai-architecture.md

# ---------- Object storage (docs/16-file-storage.md) ----------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=studentos-dev
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_REGION=us-east-1
UPLOAD_MAX_BYTES=26214400               # 25 MiB per file

# ---------- Transactional email (needed from Phase 2: verification, password reset) ----------
EMAIL_PROVIDER=console                  # console (dev) | smtp | provider-specific adapter
EMAIL_API_KEY=replace-me
EMAIL_FROM_ADDRESS=no-reply@example.com

# ---------- Observability (docs/20-observability.md) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
